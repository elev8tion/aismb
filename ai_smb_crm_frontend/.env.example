# ═══════════════════════════════════════════════════════════════════
# Environment variables for ai_smb_crm_frontend (app.kre8tion.com)
# Copy this file to .env.local and fill in real values
# Server-side vars are also bound via wrangler.toml for Cloudflare edge runtime
# ═══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────
# NocodeBackend (CRM data layer)
# ──────────────────────────────────────
NCB_INSTANCE=your-instance-name
NCB_DATA_API_URL=https://data.nocodebackend.com
NCB_AUTH_API_URL=https://auth.nocodebackend.com
NCB_OPENAPI_URL=https://openapi.nocodebackend.com
NCB_SECRET_KEY=your-ncb-secret-key

# ──────────────────────────────────────
# OpenAI (agent chat, STT, TTS)
# ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ──────────────────────────────────────
# Stripe (billing & subscriptions)
# ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ──────────────────────────────────────
# EmailIt REST API for product mail (welcome, payment-failed, signing).
# GitHub secret EMAILIT_API_KEY → Cloudflare Pages. Not SMTP.
# Auth emails (signup/reset) are sent by NCB over EmailIt SMTP — not this key.
# Voice demo does not need EMAILIT_API_KEY. See docs/EMAIL.md.
# ──────────────────────────────────────
EMAILIT_API_KEY=your-emailit-api-key
ADMIN_EMAIL=connect@elev8tion.one

# ──────────────────────────────────────
# Demo access (server-only; never commit real values)
# Testers click Enter demo — no email/password in the UI.
# TEST_EMAIL / TEST_PASSWORD are accepted as a fallback for the demo account.
# ──────────────────────────────────────
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_EMAIL=demo@example.com
DEMO_LOGIN_PASSWORD=use-a-secret-manager
# TEST_EMAIL=
# TEST_PASSWORD=

# ──────────────────────────────────────
# Public (build-time, exposed to client)
# ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=https://app.kre8tion.com
NEXT_PUBLIC_ADMIN_EMAIL=connect@elev8tion.one

# ──────────────────────────────────────
# Cloudflare KV (edge runtime bindings)
# Configured in wrangler.toml, NOT in .env
# Listed here for documentation only
# ──────────────────────────────────────
# AGENT_SESSIONS  — KV namespace for agent session storage
# RATE_LIMIT_KV   — KV namespace for rate limiting
