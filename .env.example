# Environment variables for AI KRE8TION Partners
# Copy to .env.local and fill in real values.
# These are also configured as Cloudflare KV bindings in wrangler.toml for edge runtime access.

# OpenAI
OPENAI_API_KEY=

# NocodeBackend (CRM)
NCB_INSTANCE=
NCB_DATA_API_URL=
NCB_AUTH_API_URL=
NCB_OPENAPI_URL=
NCB_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EmailIt (transactional email)
EMAILIT_API_KEY=

# Google Calendar OAuth (optional — for calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kre8tion.com/api/booking/calendar/google/callback
