# Environment variables for AI KRE8TION Partners
# Copy to .env.local and fill in real values.
# KV namespace bindings (RATE_LIMIT_KV, VOICE_SESSIONS, etc.) are configured in wrangler.toml — not needed in .env.local.

# OpenAI
OPENAI_API_KEY=

# NoCodeBackend (shared instance: 36905_ai_smb_crm)
NCB_INSTANCE=36905_ai_smb_crm
NCB_OPENAPI_URL=https://openapi.nocodebackend.com
NCB_DATA_API_URL=https://app.nocodebackend.com/api/data
NCB_AUTH_API_URL=https://app.nocodebackend.com/api/user-auth
NCB_SECRET_KEY=                    # From NCB Dashboard → Settings (full admin access)
NCB_GUEST_KEY=                     # Optional — fallback to NCB_SECRET_KEY if not set
NCB_DEFAULT_USER_ID=               # Default user_id for guest-created leads (required)

# Admin
ADMIN_API_KEY=                     # Generate: openssl rand -hex 32 (protects /admin/* routes)
ADMIN_EMAIL=connect@elev8tion.one  # Recipient for booking dossiers and alerts

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ASSESSMENT_PRICE_ID=        # Stripe Price ID for $250 on-site assessment

# EmailIt (transactional email — kre8tion.com domain verified)
EMAILIT_API_KEY=

# Google Calendar OAuth (optional — enables calendar invite on booking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kre8tion.com/api/booking/calendar/google/callback
